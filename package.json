{
  "name": "frozenlab-web",
  "version": "0.1.0",
  "private": true,
  "description": "Official website and multi-project documentation platform for FrozenLab",
  "homepage": "https://frozenlab.dev",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "docs:check": "node scripts/validate-content.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm docs:check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^11.10.1",
    "fumadocs-ui": "^15.8.5",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3"
  }
}
